# ─── Development Dockerfile ───────────────────────────────────────────────────
# Uses ts-node-dev for hot reload — mirrors the local `npm run dev` workflow.
# node_modules lives inside the container; host source is bind-mounted.

FROM node:20-alpine

# Install OS deps needed by native modules (sharp, canvas, etc.)
RUN apk add --no-cache \
    libc6-compat \
    curl \
    python3 \
    make \
    g++

WORKDIR /app

# ── Layer-cache dependencies ──────────────────────────────────────────────────
# Copy manifests first so `npm install` is only re-run when they change.
# package-lock.json is optional — the glob (*) makes it non-fatal if absent.
COPY package*.json ./

RUN npm install --include=dev

# ── Copy source ───────────────────────────────────────────────────────────────
# In dev the entire backend folder is bind-mounted over this, so this COPY
# is mainly for the production-style build path. It does no harm in dev.
COPY . .

# Backend listens on 5002 by default (matches PORT in .env)
EXPOSE 5002

# Health check — waits up to 60 s for the server to become ready
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=5 \
  CMD curl -f http://localhost:5002/api/health || exit 1

# Hot-reload dev server — skips CI checks for fast container startup
CMD ["npm", "run", "dev:docker"]
